# نمونه پیکربندی — این فایل را به «.env» در ریشه پروژه کپی کنید
# (اسکریپت deploy\setup-server.ps1 این کار را خودکار انجام می‌دهد)

# مسیر دیتابیس SQLite — روی سرور مسیر مطلق بدهید
DATABASE_URL=file:C:/emdad-chat/db/custom.db

# آدرس سرویس Ollama — مهم: به‌جای localhost از 127.0.0.1 استفاده کنید؛
# چون در Node.js جدید localhost ممکن است به IPv6 (::1) حل شود و Ollama ویندوز فقط IPv4 گوش می‌دهد
OLLAMA_BASE_URL=http://127.0.0.1:11434

# مدل پیش‌فرض گفتگو
DEFAULT_MODEL=qwen3:8b

# مدت اعتبار کش صفحات سایت کمیته امداد (ساعت)
EMDAD_CACHE_TTL_HOURS=12

# --- اختیاری ---
# تعداد توکن زمینه مدل
# OLLAMA_NUM_CTX=8192
# مهلت پاسخ Ollama (میلی‌ثانیه)
# OLLAMA_TIMEOUT_MS=600000
# سرور متا-جستجوی شخصی برای جستجوی وب
# SEARXNG_URL=http://127.0.0.1:8080

# هشدار: متغیر MOCK_LLM را روی سرور تنظیم نکنید (فقط برای تست رابط کاربری بدون Ollama است)
