                <tr>
                    <td rowspan="6">منطقه زندگی</td>
                    <td rowspan="6">ضریب محرومیت</td>
                    <td>روستای ضریب ۹</td>
                    <td>۵۰</td>
                    <td rowspan="6"></td>
                </tr>
                <tr><td>مناطق ویژه شهری</td><td>۴۵</td></tr>
                <tr><td>روستای ضریب ۷</td><td>۴۰</td></tr>
