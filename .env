DATABASE_URL=file:/home/z/my-project/db/custom.db
# آدرس سرویس Ollama روی سرور (در سرور خودتان همین پیش‌فرض درست است)
OLLAMA_BASE_URL=http://localhost:11434
# مدل پیش‌فرض
DEFAULT_MODEL=qwen3:8b
# حالت آزمایشی (روی سرور واقعی حتماً false یا حذف شود)
MOCK_LLM=true
# مدت اعتبار کش صفحات emdad.ir (ساعت)
EMDAD_CACHE_TTL_HOURS=12
